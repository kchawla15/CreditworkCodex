@model CreditWorks.Web.ViewModels.CategoryEditViewModel
@{ ViewData["Title"] = "Edit category"; }
<div class="form-shell">
    <a class="back-link" asp-action="Index">← Back to categories</a><p class="eyebrow">CONFIGURATION</p><h1>Edit category</h1>
    <p class="muted">Changing a boundary also moves the neighboring category's matching boundary. The first range starts at 0; the final range has no upper limit.</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-field"><label asp-for="Name">Category name</label><input asp-for="Name" /><span asp-validation-for="Name"></span></div>
        <div class="form-field"><label asp-for="Icon">Icon</label><select asp-for="Icon" asp-items="Model.Icons"></select><span asp-validation-for="Icon"></span></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="MinimumWeight">Minimum weight (kg)</label><input asp-for="MinimumWeight" type="number" min="0" step="0.01" /><span asp-validation-for="MinimumWeight"></span></div>
            <div class="form-field"><label asp-for="MaximumWeight">Maximum weight (kg)</label><input asp-for="MaximumWeight" type="number" min="0" step="0.01" placeholder="Open ended for final range" /><span asp-validation-for="MaximumWeight"></span></div>
        </div>
        <div class="form-actions"><button class="button button-primary" type="submit">Save changes</button><a class="button button-quiet" asp-action="Index">Cancel</a></div>
    </form>
</div>
