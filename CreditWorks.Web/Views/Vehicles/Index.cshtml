@model IReadOnlyList<CreditWorks.Web.Services.VehicleListItem>
@{ ViewData["Title"] = "Vehicles"; var sort = (string)ViewBag.Sort; var direction = (string)ViewBag.Direction; }
<div class="page-heading">
    <div><p class="eyebrow">YOUR FLEET</p><h1>Vehicles</h1><p class="muted">Categories are calculated from the latest weight ranges.</p></div>
    <a class="button button-primary" asp-action="Create">＋ Add vehicle</a>
</div>
<div class="toolbar">
    <span class="count">@Model.Count vehicle@(Model.Count == 1 ? "" : "s")</span><span class="sort-label">Sort by</span>
    @foreach (var field in new[] { (Key: "owner", Label: "Owner"), (Key: "manufacturer", Label: "Manufacturer"), (Key: "year", Label: "Year"), (Key: "weight", Label: "Weight") })
    {
        var nextDirection = sort == field.Key && direction == "asc" ? "desc" : "asc";
        <a class="sort-link @(sort == field.Key ? "selected" : "")" asp-route-sort="@field.Key" asp-route-direction="@nextDirection">
            @field.Label @if (sort == field.Key) { <span aria-label="@(direction == "asc" ? "ascending" : "descending")">@(direction == "asc" ? "↑" : "↓")</span> }
        </a>
    }
</div>
<div class="table-wrap"><table>
    <thead><tr><th>Owner</th><th>Manufacturer</th><th>Year</th><th>Weight</th><th>Weight category</th></tr></thead>
    <tbody>
    @if (Model.Count == 0) { <tr><td class="empty" colspan="5">No vehicles yet. Add your first vehicle to get started.</td></tr> }
    @foreach (var vehicle in Model)
    {
        <tr><td class="owner">@vehicle.OwnerName</td><td>@vehicle.Manufacturer</td><td>@vehicle.YearOfManufacture</td><td>@vehicle.WeightKg.ToString("N2") kg</td>
            <td><span class="category-badge"><span class="vehicle-icon" aria-hidden="true">@CreditWorks.Web.Models.VehicleIcons.Symbol(vehicle.CategoryIcon)</span>@vehicle.CategoryName</span></td></tr>
    }
    </tbody>
</table></div>
