<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CreditWorks</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Vehicles" asp-action="Index"><span class="brand-mark">CW</span> CreditWorks</a>
        <nav aria-label="Main navigation"><a asp-controller="Vehicles" asp-action="Index">Vehicles</a><a asp-controller="Categories" asp-action="Index">Categories</a></nav>
    </header>
    <main class="container">
        @if (TempData["Success"] is string success) { <div class="notice notice-success" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="notice notice-error" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="footer">CreditWorks · Vehicle weight categories</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
